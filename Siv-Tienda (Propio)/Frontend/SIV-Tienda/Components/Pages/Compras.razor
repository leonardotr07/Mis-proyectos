@page "/compras"
@using SIV_Tienda.Services
@inject ApiClient ApiClient
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<h1> Historial de Compras </h1>

<a href="/registrar-compra" class="btn btn-success mb-3">+ Nueva Compra</a>

@if (!string.IsNullOrEmpty(mensaje))
{
    <div class="alert @claseMensaje alert-dismissible fade show" role="alert">
        @mensaje
        <button type="button" class="btn-close" @onclick="() => mensaje = null"></button>
    </div>
}

@if (compras == null)
{
    <p>Cargando...</p>
}
else if (!compras.Any())
{
    <div class="alert alert-info">No hay compras registradas.</div>
}
else
{
    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Proveedor</th>
                <th>Fecha</th>
                <th>Total</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in compras)
            {
                <tr>
                    <td>@c.Id</td>
                    <td>@c.Proveedor?.Nombre</td>
                    <td>@c.FechaCompra.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@c.Total?.Monto.ToString("C")</td>
                    <td>
                        <span class="badge @ObtenerClaseEstado(c.Estado)">
                            @c.Estado
                        </span>
                    </td>
                    <td>
                        <div class="d-flex gap-2 flex-wrap">
                            <a href="/compras/@c.Id" class="btn btn-sm btn-info text-white">Ver</a>

                            @if (c.Estado == CompraEstado.PENDIENTE)
                            {
                                <button type="button" class="btn btn-sm btn-danger"
                                        disabled="@procesando"
                                        @onclick="() => AnularCompra(c.Id)">
                                    Anular
                                </button>

                                <button type="button" class="btn btn-sm btn-success"
                                        disabled="@procesando"
                                        @onclick="() => PagarCompra(c.Id)">
                                    Pagar
                                </button>
                            }

                            @if (c.Estado == CompraEstado.COMPLETADA)
                            {
                                <button type="button" class="btn btn-sm btn-primary"
                                        disabled="@procesando"
                                        @onclick="() => RecibirCompra(c.Id)">
                                    Recibido
                                </button>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private ICollection<Compra>? compras;

    private string? mensaje;
    private string claseMensaje = "alert-info";
    private bool procesando = false;

    protected override async Task OnInitializedAsync()
    {
        compras = await ApiClient.ListarComprasAsync();
    }
    private async Task CargarCompras()
    {
        compras = await ApiClient.ListarComprasAsync();
    }
    private async Task AnularCompra(long id)
    {
        bool confirmado = await JSRuntime.InvokeAsync<bool>("confirm", "¿Confirma anular esta compra?");
        if (!confirmado)
        {
            return;
        }

        procesando = true;
        try
        {
            await ApiClient.AnularCompraAsync(id);
            mensaje = "Compra anulada correctamente.";
            claseMensaje = "alert-success";
        }
        catch (ApiException ex) when (ex.StatusCode == 404)
        {
            mensaje = "No se encontro la compra indicada.";
            claseMensaje = "alert-danger";
        }
        catch (ApiException ex) when (ex.StatusCode == 409)
        {
            mensaje = "No se puede anular: " + ex.Response;
            claseMensaje = "alert-warning";
        }
        finally
        {
            procesando = false;
            await CargarCompras();
        }
    }

    private async Task PagarCompra(long id)
    {
        bool confirmado = await JSRuntime.InvokeAsync<bool>("confirm", "¿Confirma pagar esta compra al proveedor?");
        if (!confirmado)
        {
            return;
        }

        procesando = true;
        try
        {
            await ApiClient.PagarCompraAsync(id);
            mensaje = "Compra pagada correctamente.";
            claseMensaje = "alert-success";
        }
        catch (ApiException ex) when (ex.StatusCode == 404)
        {
            mensaje = "No se encontro la compra indicada.";
            claseMensaje = "alert-danger";
        }
        catch (ApiException ex) when (ex.StatusCode == 409)
        {
            mensaje = "No se puede pagar: " + ex.Response;
            claseMensaje = "alert-warning";
        }
        finally
        {
            procesando = false;
            await CargarCompras();
        }
    }
    private string ObtenerClaseEstado(CompraEstado estado)
    {
        return estado switch
        {
            CompraEstado.PENDIENTE => "bg-warning text-dark",
            CompraEstado.RECIBIDA => "bg-primary",
            CompraEstado.COMPLETADA => "bg-success",
            CompraEstado.ANULADA => "bg-danger",
            _ => "bg-secondary"
        };
    }
    private async Task RecibirCompra(long id)
    {
        bool confirmado = await JSRuntime.InvokeAsync<bool>("confirm", "¿Confirma que la mercadería fue recibida?");
        if (!confirmado)
        {
            return;
        }

        procesando = true;
        try
        {
            await ApiClient.RecibirCompraAsync(id);
            mensaje = "Compra marcada como recibida correctamente.";
            claseMensaje = "alert-success";
        }
        catch (ApiException ex) when (ex.StatusCode == 404)
        {
            mensaje = "No se encontro la compra indicada.";
            claseMensaje = "alert-danger";
        }
        catch (ApiException ex) when (ex.StatusCode == 409)
        {
            mensaje = "No se puede marcar como recibida: " + ex.Response;
            claseMensaje = "alert-warning";
        }
        finally
        {
            procesando = false;
            await CargarCompras();
        }
    }
}