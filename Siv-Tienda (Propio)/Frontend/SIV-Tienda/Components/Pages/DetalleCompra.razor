@page "/compras/{id:long}"
@using SIV_Tienda.Services
@inject ApiClient ApiClient
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<h1>🧾 Detalle de Compra</h1>

<a href="/compras" class="btn btn-secondary mb-3">← Volver al historial</a>

@* Alerta para mostrar el resultado de anular/pagar *@
@if (!string.IsNullOrEmpty(mensaje))
{
    <div class="alert @claseMensaje alert-dismissible fade show" role="alert">
        @mensaje
        <button type="button" class="btn-close" @onclick="() => mensaje = null"></button>
    </div>
}

@if (compra == null && !cargando)
{
    <div class="alert alert-danger">No se encontró la compra.</div>
}
else if (cargando)
{
    <p>Cargando...</p>
}
else
{
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <strong>Compra #@compra.Id</strong>
            <span class="badge @ObtenerClaseEstado(compra.Estado)">@compra.Estado</span>
        </div>
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-6">
                    <h5>Proveedor</h5>
                    <p>
                        <strong>Nombre:</strong> @compra.Proveedor?.Nombre<br />
                        <strong>RUC:</strong> @compra.Proveedor?.Ruc<br />
                        <strong>Teléfono:</strong> @compra.Proveedor?.Telefono<br />
                        <strong>Email:</strong> @compra.Proveedor?.Email<br />
                        <strong>Dirección:</strong> @compra.Proveedor?.Direccion
                    </p>
                </div>
                <div class="col-md-6 text-md-end">
                    <h5>Información</h5>
                    <p>
                        <strong>Fecha:</strong> @compra.FechaCompra.ToString("dd/MM/yyyy HH:mm")<br />
                        <strong>Total:</strong> <span class="fw-bold">@compra.Total?.Monto.ToString("C")</span>
                    </p>
                </div>
            </div>
            @*botones de accion Anular / Pagar dentro del detalle*@
            <div class="mb-3">
                @if (compra.Estado != CompraEstado.ANULADA
                    && compra.Estado != CompraEstado.RECIBIDA
                    && compra.Estado != CompraEstado.COMPLETADA)
                {
                    <button type="button" class="btn btn-danger"
                            disabled="@procesando"
                            @onclick="AnularCompra">
                        Anular compra
                    </button>
                }
                @if (compra.Estado != CompraEstado.ANULADA
                    && compra.Estado != CompraEstado.COMPLETADA)
                {
                    <button type="button" class="btn btn-success"
                            disabled="@procesando"
                            @onclick="PagarCompra">
                        Pagar compra
                    </button>
                }
            </div>

            <h5>Líneas de compra</h5>
            <table class="table table-striped table-bordered">
                <thead class="table-dark">
                    <tr>
                        <th>#</th>
                        <th>Producto</th>
                        <th>Cantidad</th>
                        <th>Precio Unitario</th>
                        <th>Subtotal</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var linea in compra.Lineas)
                    {
                        <tr>
                            <td>@linea.Id</td>
                            <td>@linea.DatProducto?.Nombre</td>
                            <td>@linea.Cantidad</td>
                            <td>@linea.PrecioUnitario?.Monto.ToString("C")</td>
                            <td>@linea.SubTotal?.Monto.ToString("C")</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="fw-bold">
                        <td colspan="4" class="text-end">Total</td>
                        <td>@compra.Total?.Monto.ToString("C")</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
}

@code {
    [Parameter] public long Id { get; set; }

    private Compra? compra;
    private bool cargando = true;
    //Variables de estado de mensajes y bloqueo de botones
    private string? mensaje;
    private string claseMensaje = "alert-info";
    private bool procesando = false;
    protected override async Task OnInitializedAsync()
    {
        try
        {
            compra = await ApiClient.ObtenerCompraAsync(Id);
        }
        catch (ApiException ex) when (ex.StatusCode == 404)
        {
            compra = null;
        }
        catch (Exception ex)
        {
            // Puedes mostrar un mensaje de error si quieres
            Console.WriteLine($"Error: {ex.Message}");
        }
        finally
        {
            cargando = false;
        }
    }
    private async Task CargarCompra()
    {
        //Se extrae la carga de la compra a un método reutilizable
        //para poder refrescar el detalle después de anular o pagar
        cargando = true;
        try
        {
            compra = await ApiClient.ObtenerCompraAsync(Id);
        }
        catch (ApiException ex) when (ex.StatusCode == 404)
        {
            compra = null;
        }
        catch (Exception ex)
        {
            // Puedes mostrar un mensaje de error si quieres
            Console.WriteLine($"Error: {ex.Message}");
        }
        finally
        {
            cargando = false;
        }
    }
    private string ObtenerClaseEstado(CompraEstado estado)
    {
        return estado switch
        {
            CompraEstado.PENDIENTE => "bg-warning text-dark",
            CompraEstado.RECIBIDA => "bg-primary",
            CompraEstado.COMPLETADA => "bg-success",
            CompraEstado.ANULADA => "bg-danger",
            _ => "bg-secondary"
        };
    }
    //Método que ejecuta la anulación de la compra actual.
    private async Task AnularCompra()
    {
        bool confirmado = await JSRuntime.InvokeAsync<bool>("confirm", "¿Confirma anular esta compra?");
        if (!confirmado)
        {
            return;
        }

        procesando = true;
        try
        {
            await ApiClient.AnularCompraAsync(Id);
            mensaje = "Compra anulada correctamente.";
            claseMensaje = "alert-success";
        }
        catch (ApiException ex) when (ex.StatusCode == 404)
        {
            mensaje = "No se encontro la compra indicada.";
            claseMensaje = "alert-danger";
        }
        catch (ApiException ex) when (ex.StatusCode == 409)
        {
            mensaje = "No se puede anular: " + ex.Response;
            claseMensaje = "alert-warning";
        }
        finally
        {
            procesando = false;
            // Se recarga la compra para reflejar el nuevo estado en la vista
            await CargarCompra();
        }
    }
    //Cambio método que ejecuta el pago de la compra actual
    private async Task PagarCompra()
    {
        bool confirmado = await JSRuntime.InvokeAsync<bool>("confirm", "¿Confirma pagar esta compra al proveedor?");
        if (!confirmado)
        {
            return;
        }

        procesando = true;
        try
        {
            await ApiClient.PagarCompraAsync(Id);
            mensaje = "Compra pagada correctamente.";
            claseMensaje = "alert-success";
        }
        catch (ApiException ex) when (ex.StatusCode == 404)
        {
            mensaje = "No se encontro la compra indicada.";
            claseMensaje = "alert-danger";
        }
        catch (ApiException ex) when (ex.StatusCode == 409)
        {
            mensaje = "No se puede pagar: " + ex.Response;
            claseMensaje = "alert-warning";
        }
        finally
        {
            procesando = false;
            await CargarCompra();
        }
    }
}